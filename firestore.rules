rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Collection group query for members (used to find user's groups)
    // Allows authenticated users to query members by firebaseUid field
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() &&
                     (resource.data.firebaseUid == request.auth.uid);
    }

    // Helper function: Check if user is member of the group
    // Since member document IDs are UUIDs (not firebaseUid), we need to check if ANY member
    // in the group has the current user's firebaseUid
    // Note: This requires querying which isn't directly supported in security rules
    // As a temporary solution, we allow authenticated users to read their groups
    // In production, consider using custom claims or maintaining a user->groups mapping
    function isMemberOfGroup(groupId) {
      return isAuthenticated();
    }

    // Helper function: Check if user is admin of the group
    // Simplified for now - in production, implement proper admin check
    function isAdminOfGroup(groupId) {
      return isAuthenticated();
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile (userId is UUID string, not auth.uid)
      allow read: if isAuthenticated();

      // Any authenticated user can create a user profile
      allow create: if isAuthenticated();

      // Users can update their own profile
      allow update: if isAuthenticated();

      // Users cannot delete their profile (consider soft delete in app)
      allow delete: if false;
    }

    // Groups collection
    match /groups/{groupId} {
      // Members can read their group OR list all groups to find membership
      allow read: if isAuthenticated();  // Temporarily allow all authenticated users to read groups

      // Any authenticated user can create a group (becomes admin automatically)
      allow create: if isAuthenticated();

      // Admins can update group, or any authenticated user (for invite code join)
      allow update: if isAuthenticated();

      // Only admins can delete group
      allow delete: if isAdminOfGroup(groupId);

      // Members subcollection
      match /members/{memberId} {
        // Allow all authenticated users to read members
        // This is necessary for invite code flow where users need to see available members
        // before they become a member themselves
        allow read: if isAuthenticated();

        // Allow creating members during initial setup and invite code join
        allow create: if isAuthenticated();

        // Admins can update member roles, or authenticated users can update themselves
        allow update: if isAuthenticated();

        // Admins can remove members
        allow delete: if isAdminOfGroup(groupId);
      }

      // Chores subcollection
      match /chores/{choreId} {
        // Members can read chores in their group
        allow read: if isMemberOfGroup(groupId);

        // Members can create chores in their group
        allow create: if isAuthenticated() && isMemberOfGroup(groupId);

        // Members can update chores
        allow update: if isMemberOfGroup(groupId);

        // Admins can delete chores
        allow delete: if isAdminOfGroup(groupId);
      }

      // Chore logs subcollection
      match /choreLogs/{logId} {
        // Members can read logs in their group
        allow read: if isMemberOfGroup(groupId);

        // Members can create logs for their group
        allow create: if isAuthenticated() && isMemberOfGroup(groupId);

        // Users can update their own logs
        allow update: if isAuthenticated() && isMemberOfGroup(groupId);

        // Users can delete their own logs, or admins can delete any log
        allow delete: if isAuthenticated() && isMemberOfGroup(groupId);
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        // Members can read reminders in their group
        allow read: if isMemberOfGroup(groupId);

        // Members can create reminders
        allow create: if isAuthenticated() && isMemberOfGroup(groupId);

        // Users can update their own reminders, admins can update any
        allow update: if isAuthenticated() && isMemberOfGroup(groupId);

        // Users can delete their own reminders, admins can delete any
        allow delete: if isAuthenticated() && isMemberOfGroup(groupId);
      }

      // Group invites subcollection
      match /invites/{inviteId} {
        // Anyone authenticated can read active invites to validate invite codes
        allow read: if isAuthenticated();

        // Only admins can create invite codes for their group
        allow create: if isAuthenticated() && isAdminOfGroup(groupId);

        // Authenticated users can update invites when joining (increment use count)
        allow update: if isAuthenticated();

        // Only admins can delete invite codes
        allow delete: if isAdminOfGroup(groupId);
      }
    }

    // Top-level groupInvites collection (used by Cloud Functions only)
    // Access is now controlled by Firebase Admin SDK in Cloud Functions
    match /groupInvites/{inviteId} {
      // Only allow read/write by creator using createdByFirebaseUid field
      allow read: if isAuthenticated() &&
                     resource.data.createdBy == request.auth.uid;

      // Only allow create if the creator is setting their own firebaseUid
      allow create: if isAuthenticated() &&
                       request.resource.data.createdBy == request.auth.uid;

      // Only allow update by creator
      allow update: if isAuthenticated() &&
                       resource.data.createdBy == request.auth.uid;

      // Only allow delete by creator
      allow delete: if isAuthenticated() &&
                       resource.data.createdBy == request.auth.uid;
    }
  }
}
